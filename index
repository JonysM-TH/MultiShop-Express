<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tienda Online con Carrito y Firebase</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #3498db;
            color: white;
            padding: 20px;
            text-align: center;
        }
        h1 {
            margin: 0;
        }
        .catalogo {
            display: flex;
            justify-content: center;
            margin: 20px;
            flex-wrap: wrap;
        }
        .producto {
            background-color: white;
            margin: 15px;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 250px;
            text-align: center;
        }
        .producto img {
            width: 100%;
            height: auto;
            border-radius: 8px;
        }
        .producto h3 {
            margin: 15px 0 10px;
            color: #3498db;
        }
        .producto .precio {
            font-size: 18px;
            color: #e74c3c;
            font-weight: bold;
        }
        .boton {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }
        .boton:hover {
            background-color: #27ae60;
        }
        footer {
            background-color: #2c3e50;
            color: white;
            padding: 15px;
            text-align: center;
        }
        .carrito {
            background-color: #f39c12;
            color: white;
            padding: 10px;
            text-align: center;
            cursor: pointer;
        }
        .carrito:hover {
            background-color: #e67e22;
        }
    </style>
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.1.2/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.1.2/firebase-firestore.js"></script>
</head>
<body>

<header>
    <h1>Tienda Online</h1>
    <p>Compra los mejores productos con solo un clic.</p>
</header>

<section class="catalogo">
    <div class="producto" data-id="1">
        <img src="https://via.placeholder.com/250" alt="Producto 1">
        <h3>Producto 1</h3>
        <p>Descripción del producto 1.</p>
        <p class="precio">$10.00</p>
        <button class="boton" onclick="agregarAlCarrito(1, 'Producto 1', 10)">Agregar al carrito</button>
    </div>
    <div class="producto" data-id="2">
        <img src="https://via.placeholder.com/250" alt="Producto 2">
        <h3>Producto 2</h3>
        <p>Descripción del producto 2.</p>
        <p class="precio">$20.00</p>
        <button class="boton" onclick="agregarAlCarrito(2, 'Producto 2', 20)">Agregar al carrito</button>
    </div>
    <div class="producto" data-id="3">
        <img src="https://via.placeholder.com/250" alt="Producto 3">
        <h3>Producto 3</h3>
        <p>Descripción del producto 3.</p>
        <p class="precio">$30.00</p>
        <button class="boton" onclick="agregarAlCarrito(3, 'Producto 3', 30)">Agregar al carrito</button>
    </div>
</section>

<div class="carrito" onclick="verCarrito()">
    Ver carrito (0)
</div>

<footer>
    <p>&copy; 2025 Tienda Online. Todos los derechos reservados.</p>
</footer>

<script>
    // Firebase configuration
    const firebaseConfig = {
        apiKey: "YOUR_API_KEY",
        authDomain: "YOUR_AUTH_DOMAIN",
        projectId: "YOUR_PROJECT_ID",
        storageBucket: "YOUR_STORAGE_BUCKET",
        messagingSenderId: "YOUR_MESSAGING_SENDER_ID",
        appId: "YOUR_APP_ID"
    };

    // Inicializa Firebase
    const app = firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore(app);

    // Carrito en el almacenamiento local
    let carrito = JSON.parse(localStorage.getItem('carrito')) || [];

    // Función para agregar productos al carrito
    function agregarAlCarrito(id, nombre, precio) {
        carrito.push({ id, nombre, precio });
        localStorage.setItem('carrito', JSON.stringify(carrito));
        actualizarCarrito();
    }

    // Función para ver el carrito
    function verCarrito() {
        alert("Carrito:\n" + carrito.map(item => item.nombre + " - $" + item.precio).join('\n'));
    }

    // Función para actualizar el número de productos en el carrito
    function actualizarCarrito() {
        document.querySelector('.carrito').textContent = `Ver carrito (${carrito.length})`;
    }

    // Inicializar el carrito al cargar la página
    actualizarCarrito();

    // Función para agregar productos a Firebase
    function agregarProductoFirebase(nombre, descripcion, precio) {
        db.collection("productos").add({
            nombre: nombre,
            descripcion: descripcion,
            precio: precio
        })
        .then(() => {
            alert("Producto agregado con éxito en Firebase");
        })
        .catch((error) => {
            console.error("Error al agregar el producto a Firebase: ", error);
        });
    }
</script>

</body>
</html>
